{
  "manifest_version": 3,
  "name": "CyberSwitch 10X - 1-Click ATS Autofill",
  "version": "1.0.0",
  "description": "1-Click form autofill for Workday, Greenhouse, Lever, and Taleo candidate applications.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.myworkdayjobs.com/*",
    "https://boards.greenhouse.io/*",
    "https://jobs.lever.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CyberSwitch 1-Click Autofill"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.myworkdayjobs.com/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.lever.co/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
